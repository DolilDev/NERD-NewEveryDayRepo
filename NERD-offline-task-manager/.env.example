# Firebase Firestore configuration for optional cloud sync.
# Copy this file to ".env" and fill in the values from your Firebase project
# (Project settings -> General -> Your apps -> SDK setup and configuration).
# Leave .env absent to run the app fully offline; cloud sync stays disabled.

FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Optional — sensible defaults are derived when omitted.
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_TASKS_COLLECTION=tasks
